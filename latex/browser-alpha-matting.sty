\RequirePackage{amsmath}
\RequirePackage{amssymb}

\newcommand{\CompositeChannel}[3]{#1 \, #2 + (1 - #1) \, #3}
\newcommand{\UnmixForeground}[4]{\operatorname{clamp}_{[0,1]}\!\left(\frac{#1 - (1 - #2)\,#3}{\max(#2, #4)}\right)}
\newcommand{\HermiteStep}[1]{3{#1}^{2} - 2{#1}^{3}}
\newcommand{\DicomMetricMm}[4]{\sqrt{\left(#1 \cdot #4\right)^{2} + \left(#2 \cdot #3\right)^{2}}}

