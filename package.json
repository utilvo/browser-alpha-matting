{
  "name": "browser-alpha-matting",
  "version": "1.1.1",
  "description": "Zero-dependency client-side alpha-matting SDK combining WebGPU/WASM neural saliency masks with Euclidean sRGB & CIE76 Lab color-keying, Joint Bilateral 4K upsampling, separable O(W*H) morphology, and foreground color decontamination.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./worker": "./src/worker/rmbg-worker.mjs"
  },
  "bin": {
    "browser-alpha-matting-bench": "./benchmarks/run-benchmarks.mjs"
  },
  "scripts": {
    "test": "node --test test/matting.test.mjs test/advanced-kernels.test.mjs",
    "bench": "node benchmarks/run-benchmarks.mjs"
  },
  "keywords": [
    "alpha-matting",
    "webgpu",
    "webassembly",
    "background-removal",
    "color-key",
    "joint-bilateral",
    "cie-lab",
    "rmbg",
    "image-segmentation",
    "canvas",
    "client-side",
    "web-worker"
  ],
  "homepage": "https://utilvo.github.io/browser-alpha-matting/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utilvo/browser-alpha-matting.git"
  },
  "bugs": {
    "url": "https://github.com/utilvo/browser-alpha-matting/issues"
  },
  "author": "Islam Ayoub <info@utilvo.com>",
  "license": "MIT",
  "files": [
    "src/",
    "benchmarks/",
    "examples/",
    "mod.ts",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
